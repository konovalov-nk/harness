# Remote execution configuration (rtmate tool)
# Copy to remote.env and fill in real values. remote.env is gitignored.

# Required: set one of REMOTE_CONTAINER (docker) or REMOTE_HOST (ssh)

# REMOTE_MODE=docker
REMOTE_MODE=ssh

# Docker mode (required when REMOTE_MODE=docker)
REMOTE_CONTAINER=your-container-name

# SSH mode (required when REMOTE_MODE=ssh)
REMOTE_HOST=your-ssh-host-alias

# tmux defaults
REMOTE_TMUX=work
REMOTE_AGENT_WIN=agent

# streaming settings (optional)
# REMOTE_STREAM=1
# REMOTE_STREAM_FILE=/tmp/remote-run.log
